# build output
/bin/
*.test
coverage.out

# local identity and secrets: spagetti writes keypairs and access passwords here.
# They must never be committed — a pinned peer's password is the channel PSK.
.spagetti/
*.key
identity.pub
access.password

# scratch
*.log
.tmp_*/
.DS_Store

# the gateway config for the deployed relay: it holds the bearer tokens, is
# passed to docker_build.sh as a BuildKit secret, and must never be committed.
.mux_config.json
cmd/spagetti-gateway/embedded_gen.go
